# ---- Local LLM (Ollama) ----
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.2

# Per-agent model routing (see src/llm.py). Pull these:
#   ollama pull llama3.3:70b
#   ollama pull qwen2.5:72b
#   ollama pull deepseek-r1:70b
OLLAMA_ROLE_MODELS={"discovery": "llama3.3:70b", "website": "qwen2.5:72b", "marketing": "llama3.3:70b", "social": "qwen2.5:72b", "product_trend": "deepseek-r1:70b", "sentiment": "qwen2.5:72b", "competitor": "deepseek-r1:70b", "recommendation": "deepseek-r1:70b"}

# ---- Optional remote fallback (leave as "none" for pure local) ----
FALLBACK_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---- Workflow tuning ----
DISCOVERY_TARGET=10
MIN_CONFIDENCE=50
ANALYSIS_WORKERS=3

# ---- Google Sheets knowledge base (optional) ----
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_ID=

# ---- APScheduler automation ----
SCHEDULER_ENABLED=false
DAILY_HOUR=6
DAILY_MINUTE=0
WEEKLY_DAY=mon
WEEKLY_HOUR=6
MONTHLY_DAY=1
QUARTERLY_MONTHS=1,4,7,10
YEARLY_MONTH=1

# ---- Anti-bot fetch layer ----
# "http" (fast, static pages) or "playwright" (headless Chromium for JS sites,
# Shopify/Woo checkout flows, Cloudflare challenges). Install chromium once:
#   playwright install chromium
FETCH_MODE=http
# Residential proxy exit (Bright Data / Oxylabs etc.), e.g. http://user:pass@host:port
PROXY_URL=
FETCH_RETRIES=2
FETCH_TIMEOUT=30
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_STEALTH=true

# ---- Data-source API adapters (optional; "none" keeps everything local) ----
# Lead discovery: none | serper | value_serp | data_for_seo
SERP_PROVIDER=none
SERPER_API_KEY=
VALUE_SERP_API_KEY=
DATA_FOR_SEO_USER=
DATA_FOR_SEO_PASSWORD=
# Free Google PageSpeed Insights key (https://pagespeed.web.dev)
PAGESPEED_API_KEY=
# SEO datasets: none | ahrefs | semrush | moz
SEO_PROVIDER=none
AHREFS_API_LINK=https://apiv2.ahrefs.com
AHREFS_API_KEY=
SEMRUSH_API_KEY=
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=
# Social listening: none | apify | brandwatch
SOCIAL_PROVIDER=none
APIFY_API_KEY=
BRANDWATCH_API_TOKEN=

# ---- PostgreSQL + pgvector (optional; JSON store used when unset) ----
# Apply schema first:  psql "$DATABASE_URL" -f deploy/schema.sql
DATABASE_URL=
DB_POOL_SIZE=5
EMBEDDING_MODEL=mxbai-embed-large   # ollama pull mxbai-embed-large
EMBEDDING_DIM=1024

# ---- Distributed tasks (Celery + Redis) ----
# Start worker:  celery -A src.services.tasks worker --loglevel=info
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- API + dashboard ----
# API:  python main.py --serve        Dashboard:  python main.py --dashboard
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_TITLE=ecom-intel Dashboard

# ---- Logging ----
LOG_LEVEL=INFO